{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaviX presentation v1 (canonical and compatibility alias)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preferred",
    "supported"
  ],
  "properties": {
    "schema": {
      "const": "tavix.presentation/v1"
    },
    "preferred": {
      "enum": [
        "embedded",
        "native-window",
        "split-pane",
        "floating-panel",
        "detached"
      ]
    },
    "supported": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "embedded",
          "native-window",
          "split-pane",
          "floating-panel",
          "detached"
        ]
      },
      "contains": {
        "const": "embedded"
      }
    },
    "minimumSize": {
      "$ref": "#/$defs/size"
    },
    "preferredSize": {
      "$ref": "#/$defs/size"
    },
    "responsive": {
      "type": "boolean"
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 280,
          "maximum": 2400
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 1800
        }
      }
    }
  },
  "$comment": "Runtime also requires preferred to be supported and forbids simultaneous detached and native-window aliases. This is not a privilege grant."
}
