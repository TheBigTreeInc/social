{
  "schema": "tavi.extension/v1",
  "id": "inc.thebigtree.tavi.atrium",
  "version": "1.0.0",
  "name": "Atrium",
  "summary": "Discover social games, lobbies and multiplayer activity without replacing the messenger.",
  "publisher": "thebigtreeinc",
  "kind": "app",
  "hostApi": { "min": "1.1.0", "maxExclusive": "2.0.0" },
  "entrypoints": { "panel": "ui/index.html" },
  "contributions": [
    { "slot": "app.launcher", "id": "games", "label": "Atrium Games", "action": "openPanel" }
  ],
  "permissions": [ "ui.panel", "games.catalog.read", "notifications.submit" ],
  "platforms": [ "windows", "android", "web" ]
}
