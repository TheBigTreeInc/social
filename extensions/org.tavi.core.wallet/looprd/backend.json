{
  "schema": "tavi.looprd-wallet-backend/v2",
  "extensionId": "org.tavi.core.wallet",
  "apiSchema": "tavi.wallet/v1",
  "uiBroker": {
    "component": "looprd-social",
    "authRealm": "tavi-social",
    "userHandler": "/wallet"
  },
  "serviceComponent": {
    "component": "tavi-wallet",
