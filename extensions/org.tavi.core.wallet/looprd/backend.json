  },
  "ledger": {
    "component": "looprd-social",
    "databaseSchemaVersion": 12,
    "storageOwnership": "looprd-social",
    "migration": "planned-explicit-storage-split"
  },
  "deployment": "looprd-0.4-subcomponent-service-facade"
