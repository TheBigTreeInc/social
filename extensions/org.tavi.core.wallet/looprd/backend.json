    "auth": "database",
    "contracts": {
      "merchant": "tavi-wallet-merchant",
      "reward": "tavi-wallet-reward"
    },
    "parentBroker": {
      "component": "looprd-social",
      "contract": "tavi-wallet-ledger-broker",
