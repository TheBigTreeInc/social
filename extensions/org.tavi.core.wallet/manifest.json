{
  "schema": "tavi.extension/v1",
  "id": "org.tavi.core.wallet",
  "version": "0.3.0",
  "name": "Wallet",
  "summary": "Core Gold Wallet: free Gold for games, earned Gold for shops and exchange. Fictional currency only.",
  "publisher": "tavi",
  "kind": "app",
  "hostApi": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "entrypoints": {
    "panel": "ui/index.html"
  },
  "contributions": [
    {
      "slot": "app.launcher",
      "id": "wallet",
      "label": "Wallet",
      "action": "openPanel"
    }
  ],
  "permissions": [
    "ui.panel"
  ],
  "platforms": [
    "web",
    "windows",
    "android"
  ],
  "icon": "ui/icon.svg"
}
