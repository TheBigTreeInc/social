{
  "schema": "tavi.extension/v1",
  "id": "org.tavi.examples.notepad",
  "version": "1.0.0",
  "name": "Private Notepad",
  "summary": "An isolated example extension with private notes; no chat or account access.",
  "publisher": "tavi",
  "kind": "app",
  "hostApi": {"min":"1.0.0","maxExclusive":"2.0.0"},
