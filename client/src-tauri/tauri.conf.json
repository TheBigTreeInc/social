{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Social Messenger",
  "version": "0.1.4",
  "identifier": "inc.thebigtree.looprdsocial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Social Messenger",
        "width": 355,
        "height": 630,
        "minWidth": 315,
        "minHeight": 470,
        "backgroundColor": "#f3f8ff",
        "maxWidth": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; frame-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Classic game-focused messenger and turn alerts"
  }
}
