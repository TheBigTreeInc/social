{
  "name": "@tavi/tavix-sdk",
  "version": "1.0.3",
  "description": "TaviX 1.0 SDK for isolated Tavi applications and typed service adapters",
  "type": "module",
  "files": [
    "index.js",
    "index.d.ts",
    "service.js",
    "service.d.ts",
    "README.md",
    "assets-client.js",
    "assets-client.d.ts",
    "ui.js",
    "ui.d.ts",
    "ui.css",
    "icons.js",
    "icons.d.ts",
    "icon-shapes.js",
    "LUCIDE_LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./service": {
      "types": "./service.d.ts",
      "default": "./service.js"
    },
    "./assets": {
      "types": "./assets-client.d.ts",
      "default": "./assets-client.js"
    },
    "./ui": {
      "types": "./ui.d.ts",
      "default": "./ui.js"
    },
    "./ui.css": "./ui.css",
    "./icons": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBigTreeInc/social.git",
    "directory": "client/extension-sdk"
  },
  "sideEffects": false
}
