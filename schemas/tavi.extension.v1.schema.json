{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavi.example/spec/tavi.extension.v1.schema.json",
  "title": "TaviX 1.0 Application Manifest (wire schema tavi.extension/v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "summary",
    "publisher",
    "kind",
    "hostApi",
    "entrypoints",
    "contributions",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "tavi.extension/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){2,}$",
      "maxLength": 120
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "publisher": {
      "type": "string",
      "pattern": "^[-a-z0-9]{2,64}$"
    },
    "kind": {
      "const": "app"
    },
    "hostApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "maxExclusive"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/version"
        },
        "maxExclusive": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel"
      ],
      "properties": {
        "panel": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[a-zA-Z0-9_/-]+\\.(?:html|css|js|png|svg|webp)$"
        }
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "id",
          "label",
          "action"
        ],
        "properties": {
          "slot": {
            "enum": [
              "app.store",
              "app.launcher"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[-a-z0-9]{1,40}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "action": {
            "const": "openPanel"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "contains": {
        "const": "ui.panel"
      },
      "items": {
        "enum": [
          "ui.panel",
          "ui.toast",
          "storage.private",
          "ziprunner.review",
          "assets.read",
          "assets.preferences.write"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "windows",
          "android"
        ]
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[a-zA-Z0-9_/-]+\\.(?:png|svg|webp)$"
    },
    "assetDependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packId",
          "compatibility",
          "capabilities",
          "optional"
        ],
        "properties": {
          "packId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "maxExclusive"
            ],
            "properties": {
              "min": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "maxExclusive": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            }
          },
          "optional": {
            "type": "boolean"
          },
          "requestCustomization": {
            "type": "boolean",
            "default": false,
            "description": "Requests preference-write permission for this pack; user consent and host grant are still required."
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "app",
            "game"
          ]
        },
        "categories": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
