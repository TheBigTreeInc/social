{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavi.example/spec/tavi.store.catalog.v1.schema.json",
  "title": "Bundled Tavi App Store Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "extensions"],
  "properties": {
    "schema": {"const": "tavi.store.catalog/v1"},
    "extensions": {
      "type": "array", "maxItems": 150,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["manifest", "files"],
        "properties": {
          "manifest": {"$ref": "tavi.extension.v1.schema.json"},
          "files": {
            "type": "array", "minItems": 1, "maxItems": 60,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256", "size"],
              "properties": {
                "path": {"type":"string", "pattern":"^[a-zA-Z0-9_/-]+\\.(?:html|css|js|png|svg|webp)$"},
                "sha256": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
                "size": {"type":"integer", "minimum":0, "maximum":1000000}
              }
            }
          }
        }
      }
    }
  }
}
