{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavi.example/spec/tavi.service.v1.schema.json",
  "title": "Tavi LoopRD service advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "apiVersion",
    "mode",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "tavi.service/v1"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "mode": {
      "enum": [
        "home",
        "external",
        "optional"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$",
        "maxLength": 80
      }
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "requiresDelegation": {
      "type": "boolean"
    }
  }
}
