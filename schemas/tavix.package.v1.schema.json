{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tavix:schema:package:v1",
  "title": "TaviX Offline Package Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "standard", "applicationId", "version", "files"],
  "properties": {
    "schema": {"const": "tavix.package/v1"},
    "standard": {"const": "tavix/1.0"},
    "applicationId": {"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){2,}$","maxLength":120},
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "files": {
      "type":"array","minItems":2,"maxItems":60,
      "items": {
        "type":"object","additionalProperties":false,"required":["path","size","sha256"],
        "properties": {
          "path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.?/)[a-zA-Z0-9_.\\/-]+$","maxLength":512},
          "size":{"type":"integer","minimum":0,"maximum":1000000},
          "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
