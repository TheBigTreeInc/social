{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavi.example/spec/tavi.extension.v2.schema.json",
  "title": "Tavi extension manifest v2 - future draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "summary",
    "publisher",
    "kind",
    "hostApi",
    "entrypoints",
    "contributions",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "tavi.extension/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){2,}$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "publisher": {
      "type": "string",
      "pattern": "^[-a-z0-9]{2,64}$"
    },
    "kind": {
      "const": "app"
    },
    "hostApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "maxExclusive"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "maxExclusive": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel"
      ],
      "properties": {
        "panel": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[a-zA-Z0-9_/-]+\\.(?:html|css|js|png|svg|webp)$"
        }
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "id",
          "label",
          "action"
        ],
        "properties": {
          "slot": {
            "enum": [
              "app.store",
              "app.launcher",
              "profile.petWidget",
              "home.wallet"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[-a-z0-9]{1,40}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "action": {
            "enum": [
              "openPanel",
              "openResource"
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 30,
      "items": {
        "enum": [
          "ui.panel",
          "ui.toast",
          "storage.private",
          "wallet.read",
          "wallet.transfer.request",
          "pets.read",
          "pets.command",
          "contacts.read",
          "messages.read",
          "messages.send",
          "events.subscribe",
          "games.sessions"
        ]
      }
    },
    "serviceBindings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "mode",
          "apiVersion",
          "capabilities"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "mode": {
            "enum": [
              "home",
              "external",
              "optional"
            ]
          },
          "apiVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$",
              "maxLength": 80
            }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "windows",
          "android"
        ]
      }
    }
  }
}
