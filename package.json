{
  "name": "looprd-social",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "npm run test:server && npm run test:client",
    "verify": "npm run test && node client/tools/check-package.mjs",
    "start:bridge": "node bridge.mjs",
    "check:looprd": "python tools/generate-looprd.py --check",
    "test:server": "node --test tests/*.test.mjs",
    "test:client": "node --test client/tests/*.test.mjs",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run web:build",
    "client:sync-portraits": "cd client && npm run portrait:sync"
  },
  "description": "LoopRD Social API and integrated Windows/Android social client (development identity only)"
}
