{
  "name": "looprd-social",
  "version": "0.3.74",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "npm run test:server && npm run test:client && npm run test:openclaw",
    "verify": "npm run test && node client/tools/check-package.mjs",
    "start:bridge": "node bridge.mjs",
    "check:looprd": "python tools/generate-looprd.py --check",
    "test:server": "node --test tests/*.test.mjs",
    "test:client": "node --test client/tests/*.test.mjs",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run web:build",
    "client:sync-portraits": "cd client && npm run portrait:sync",
    "client:web": "cd client && npm run web:build",
    "client:web-verify": "cd client && npm run web:verify",
    "test:openclaw": "node --test integrations/openclaw/tests/*.test.mjs"
  },
  "description": "Social-owned accounts, buddies, direct messages and game alerts on LoopRD with Windows/Android clients"
}
