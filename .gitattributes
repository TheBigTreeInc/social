# Byte-exact LoopRD source hashes must survive Windows Git checkouts.
# Generated API descriptors are validated against their committed SHA-256.
*.yaml text eol=lf
*.yml text eol=lf
*.adoc text eol=lf

# Bundled, SHA-256-verified extension text assets must be byte-identical on Windows.
client/public/tavi-extensions/**/*.html text eol=lf
client/public/tavi-extensions/**/*.css text eol=lf
client/public/tavi-extensions/**/*.js text eol=lf
client/public/tavi-extensions/**/*.json text eol=lf
client/public/tavi-extensions/**/*.svg text eol=lf

# Developer-facing nested descriptor fixture hashes must stay reproducible.
docs/extension-examples/nested-publisher/**/*.html text eol=lf
docs/extension-examples/nested-publisher/**/*.css text eol=lf
docs/extension-examples/nested-publisher/**/*.js text eol=lf
docs/extension-examples/nested-publisher/**/*.json text eol=lf
docs/extension-examples/nested-publisher/**/*.svg text eol=lf

# Canonical in-repository extension source, including SHA-pinned assets.
extensions/**/*.html text eol=lf
extensions/**/*.css text eol=lf
extensions/**/*.js text eol=lf
extensions/**/*.json text eol=lf
extensions/**/*.svg text eol=lf

# Raw copies must stay byte-exact regardless of Git platform text normalization.
client/public/tavi-extensions/**/*.bytes -text

# Explicit reviewed Companion publisher bytes include ONE mixed-line-ending line.
# Git text normalization stripped it on main (commit a45980a) and caused
# Reviewed partner bundle integrity changed on Linux CI, before APK builds.
extensions/org.tavi.community.companion/ui/studio-main.js -text
extensions/org.tavi.community.companion/ui/world-main.js -text
client/public/tavi-extensions/org.tavi.community.companion/ui/studio-main.js -text
client/public/tavi-extensions/org.tavi.community.companion/ui/world-main.js -text
