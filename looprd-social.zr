{
  "project_key": "looprd-social",
  "display_name": "Tavi",
  "zip_match_patterns": [
    "tavi-*-ziprunner.zip",
    "looprd-social-*-ziprunner.zip"
  ],
  "zip_patterns": [
    "tavi-*-ziprunner.zip",
    "looprd-social-*-ziprunner.zip"
  ],
  "match_patterns": [
    "tavi-*-ziprunner.zip",
    "looprd-social-*-ziprunner.zip"
  ],
  "build_commands": [
    "npm run verify",
    "node tools/auto-build.mjs"
  ],
  "start_commands": [
    "node tools/launch-tavi.mjs"
  ],
  "strip_single_root_folder": false,
  "delete_missing_files": false,
  "clean_git_tree": false,
  "post_build_requires_success": true,
  "build_window": "hidden",
  "protected_paths": [
    ".git",
    "ziprunner.config.json",
    "ziprunner.project-state.json",
    ".data",
    ".env",
    "*.local.json",
    "*.sqlite",
    "*.sqlite3",
    "node_modules",
    "client/node_modules",
    "client/dist",
    "client/src-tauri/target",
    "client/src-tauri/gen",
    ".venv"
  ],
  "git_auto_push": false
}
